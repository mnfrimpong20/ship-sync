# Postgres connection string. On Replit, add a PostgreSQL database and this is set automatically.
# When unset, Ship Sync uses an embedded Postgres (PGlite) stored in ./data/pglite — fine for dev, not for production.
DATABASE_URL=
# Fictional demo shippers auto-reply to new requests so the marketplace can be tried end-to-end. Set to "false" for real operations.
DEMO_AUTO_QUOTES=true
NODE_ENV=development
PORT=5000
# AISStream API key (free: https://aisstream.io) — enables live vessel positions on tracking pages, the live map and port congestion counts. Without it, sea shipments show an estimated position.
AISSTREAM_API_KEY=
# Optional: point the ADS-B client at a mock (default https://api.adsb.lol)
# ADSB_URL=http://localhost:9002
