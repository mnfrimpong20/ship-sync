# Postgres connection string. On Replit, add a PostgreSQL database and this is set automatically.
# When unset, Ship Sync uses an embedded Postgres (PGlite) stored in ./data/pglite — fine for dev, not for production.
DATABASE_URL=
# Fictional demo shippers auto-reply to new requests so the marketplace can be tried end-to-end. Set to "false" for real operations.
DEMO_AUTO_QUOTES=true
NODE_ENV=development
PORT=5000
# AISStream API key (free: https://aisstream.io) — enables live vessel positions on tracking pages, the live map and port congestion counts. Without it, sea shipments show an estimated position.
AISSTREAM_API_KEY=
# Optional: point the ADS-B client at a mock (default https://api.adsb.lol)
# ADSB_URL=http://localhost:9002
# Optional: alternative Nominatim-compatible geocoder for route planning (default https://nominatim.openstreetmap.org)
# NOMINATIM_URL=http://localhost:9002
# Comma-separated emails that get Ship Sync admin (shipper verification) on boot
# ADMIN_EMAILS=you@example.com

# Carrier track & trace for containers: off | mock (built-in simulator) | terminal49 | dcsa (a line's DCSA Track & Trace v2 API)
# Unset = terminal49 when TERMINAL49_API_KEY is present, else mock.
# CARRIER_TRACKING_PROVIDER=terminal49
# TERMINAL49_API_KEY=
# CARRIER_API_URL=https://api.cma-cgm.com/tracking/v2
# CARRIER_API_KEY=
# CARRIER_API_KEY_HEADER=KeyId
# CARRIER_LABEL=CMA CGM
# CARRIER_SYNC_MINUTES=15
# MOCK_CARRIER_STEP_MINUTES=30
