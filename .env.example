# Postgres connection string. On Replit, add a PostgreSQL database and this is set automatically.
# When unset, Ship Sync uses an embedded Postgres (PGlite) stored in ./data/pglite — fine for dev, not for production.
DATABASE_URL=
# Fictional demo shippers auto-reply to new requests so the marketplace can be tried end-to-end. Set to "false" for real operations.
DEMO_AUTO_QUOTES=true
NODE_ENV=development
PORT=5000
# AISStream API key (free: https://aisstream.io) — enables live vessel positions on tracking pages, the live map and port congestion counts. Without it, sea shipments show an estimated position.
AISSTREAM_API_KEY=
# Optional: point the ADS-B client at a mock (default https://api.adsb.lol)
# ADSB_URL=http://localhost:9002
# Optional: alternative Nominatim-compatible geocoder for route planning (default https://nominatim.openstreetmap.org)
# NOMINATIM_URL=http://localhost:9002
# Comma-separated emails that get Ship Sync admin (shipper verification) on boot
# ADMIN_EMAILS=you@example.com

# Carrier track & trace for containers: off | mock (built-in simulator) | terminal49 | dcsa (a line's DCSA Track & Trace v2 API)
# Unset = terminal49 when TERMINAL49_API_KEY is present, else mock.
# CARRIER_TRACKING_PROVIDER=terminal49
# TERMINAL49_API_KEY=
# CARRIER_API_URL=https://api.cma-cgm.com/tracking/v2
# CARRIER_API_KEY=
# CARRIER_API_KEY_HEADER=KeyId
# CARRIER_LABEL=CMA CGM
# CARRIER_SYNC_MINUTES=15
# MOCK_CARRIER_STEP_MINUTES=30

# Email notifications (quotes, booking confirmations, shipment milestones, leads, overdue invoices).
# Set both to send through Resend (https://resend.com); EMAIL_PROVIDER=log prints emails to the console instead.
# Without either, in-app notifications still work and emails are skipped.
# RESEND_API_KEY=
# EMAIL_FROM=Ship Sync <notify@yourdomain.com>
# EMAIL_PROVIDER=log
# Public URL used for links inside emails, e.g. https://shipsync.example.com
# APP_URL=

# Texts to the receiver in Africa (SMS / WhatsApp): sailed, arrived, out for delivery, ready for collection, delivered + the receiver link.
# Pick one provider; unset = auto-detect from keys; SMS_PROVIDER=log prints to the console. Without any, texts are skipped (the receiver link still works).
# SMS_PROVIDER=twilio|termii|africastalking|log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# TWILIO_WHATSAPP_FROM=whatsapp:+1...   (optional — switches recipient texts to WhatsApp)
# TERMII_API_KEY=
# TERMII_SENDER_ID=ShipSync
# AT_USERNAME=
# AT_API_KEY=
# AT_FROM=

# Duty estimator exchange rates (local currency per USD) — defaults are indicative; the Bank of Ghana / CBN rate on the day applies.
# GHS_PER_USD=11
# NGN_PER_USD=1550

# Payments & escrow (Stripe). Test keys (sk_test_…) work without a live business account; leave unset to disable online checkout.
# STRIPE_SECRET_KEY=
# Signing secret of a Stripe webhook pointed at https://<your-host>/api/payments/webhook (events: checkout.session.completed, checkout.session.expired, charge.refunded). Without it, payments confirm when the customer returns to the site.
# STRIPE_WEBHOOK_SECRET=
# Optional: alternative Stripe API host for tests (default https://api.stripe.com)
# STRIPE_API_URL=http://localhost:9006
# Optional: alternative NHTSA vPIC host for VIN decoding (default https://vpic.nhtsa.dot.gov/api/vehicles)
# VPIC_URL=http://localhost:9007
# Sailing schedule provider for carrier booking (default builtin = rolling indicative schedule, instant confirmations)
# SCHEDULE_PROVIDER=builtin
